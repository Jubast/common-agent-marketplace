#!/usr/bin/env bash
# Fault-injection wrapper around the REAL herdr. $HERDR_FAULTS lists rules, one
# per line:  <call>|<times>|<before|after>|<exit code>|<stdout>
# `herdr <call> ...` (the first two words) matches a rule while it has hit fewer
# than <times> times. before: reply with <stdout> and the exit code, without
# running herdr. after: run the real herdr, then replace its result.
# $HERDR_CALLS, if set, collects the arguments of every call.
[ -z "${HERDR_CALLS:-}" ] || printf '%s\n' "$*" >> "$HERDR_CALLS"
n=0
while IFS='|' read -r call times when rc out; do
  n=$((n + 1))
  [ "$1 $2" = "$call" ] || continue
  hits=$(cat "$HERDR_FAULTS.$n" 2>/dev/null || echo 0)
  [ "$hits" -lt "$times" ] || continue
  echo $((hits + 1)) > "$HERDR_FAULTS.$n"
  [ "$when" != after ] || "$HERDR_REAL" "$@" >/dev/null 2>&1
  printf '%s\n' "$out"
  exit "$rc"
done < "$HERDR_FAULTS"
exec "$HERDR_REAL" "$@"
